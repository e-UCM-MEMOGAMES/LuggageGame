  m_SharedData: {fileID: 11400000, guid: 381e72707fa25ff47b62981414a325a7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1189262585856
    m_Localized: "\xBFSeguro que ha terminado?"
    m_Metadata:
      m_Items: []
  - m_Id: 1286796931072
    m_Localized: "\xA1Enhorabuena!\nLe ha tocado un viaje gratis"
    m_Metadata:
      m_Items: []
  - m_Id: 1414970667008
    m_Localized: "\xA1Tendr\xE1 que ir a su habitaci\xF3n a preparar la maleta para
      el viaje!"
    m_Metadata:
      m_Items: []
  - m_Id: 4737568272384
    m_Localized: "\xA1Pulse el bot\xF3n de abajo para empezar!"
    m_Metadata:
      m_Items: []
  - m_Id: 4799652360192
    m_Localized: Hombre
    m_Metadata:
      m_Items: []
  - m_Id: 4822817501184
    m_Localized: Mujer
    m_Metadata:
      m_Items: []
  - m_Id: 4879528685568
    m_Localized: "Seleccione su g\xE9nero"
    m_Metadata:
      m_Items: []
  - m_Id: 4951440027648
    m_Localized: "Pulse aqu\xED para continuar"
    m_Metadata:
      m_Items: []
  - m_Id: 219731245330432
    m_Localized: El juego de la maleta
    m_Metadata:
      m_Items: []
  - m_Id: 220113489031168
    m_Localized: 'Intente memorizar los siguientes objetos e introducirlos a la maleta. 
      Para cumplir un objetivo debe haber conseguido los anteriores. '
    m_Metadata:
      m_Items: []
  - m_Id: 220481488875520
    m_Localized: Objetivos
    m_Metadata:
      m_Items: []
  - m_Id: 220568038338560
    m_Localized: "Introducir m\xE1s de la mitad de los objetos pedidos"
    m_Metadata:
      m_Items: []
  - m_Id: 220733931450368
    m_Localized: Introducir todos los objetos pedidos
    m_Metadata:
      m_Items: []
  - m_Id: 220775060795392
    m_Localized: "No meter ning\xFAn objeto innecesario"
    m_Metadata:
      m_Items: []
  - m_Id: 221170977927168
    m_Localized: No haber consultado la lista de objetos
    m_Metadata:
      m_Items: []
  - m_Id: 221417145823232
    m_Localized: ROPA
    m_Metadata:
      m_Items: []
  - m_Id: 221445746782208
    m_Localized: OTROS
    m_Metadata:
      m_Items: []
  - m_Id: 221495369592832
    m_Localized: CALZADO
    m_Metadata:
      m_Items: []
  - m_Id: 221565334777856
    m_Localized: SI
    m_Metadata:
      m_Items: []
  - m_Id: 221579918372864
    m_Localized: NO
    m_Metadata:
      m_Items: []
  - m_Id: 221603523915776
    m_Localized: "\xBFQuiere restablecer los ajustes y borrar la partida guardada?"
    m_Metadata:
      m_Items: []
  - m_Id: 221737011834880
    m_Localized: Terminar
    m_Metadata:
      m_Items: []
  - m_Id: 221791151910912
    m_Localized: Empezar
    m_Metadata:
      m_Items: []
  - m_Id: 221811104215040
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 222784782528512
    m_Localized: "Cr\xE9ditos"
    m_Metadata:
      m_Items: []
  - m_Id: 222810120318976
    m_Localized: Seleccione un nivel de dificultad
    m_Metadata:
      m_Items: []
  - m_Id: 222978102194176
    m_Localized: Seleccione su destino de vacaciones
    m_Metadata:
      m_Items: []
  - m_Id: 223097283342336
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 223120746278912
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 223141063487488
    m_Localized: "C\xE1lido"
    m_Metadata:
      m_Items: []
  - m_Id: 223164874551296
    m_Localized: "Fr\xEDo"
    m_Metadata:
      m_Items: []
  - m_Id: 223959535775744
    m_Localized: Restablecer
    m_Metadata:
      m_Items: []
  - m_Id: 191664723245023232
    m_Localized: "M\xFAsica"
    m_Metadata:
      m_Items: []
  - m_Id: 223998869958656
    m_Localized: Efectos de sonido
    m_Metadata:
      m_Items: []
  - m_Id: 225281479733248
    m_Localized: 'Objetos innecesarios:'
    m_Metadata:
      m_Items: []
  - m_Id: 225326270705664
    m_Localized: 'Objetos correctos:'
    m_Metadata:
      m_Items: []
  - m_Id: 225778970324992
    m_Localized: 'Veces que se ha consultado la lista:'
    m_Metadata:
      m_Items: []
  - m_Id: 980179829846016
    m_Localized: Sin soltar, arrastre la camiseta hasta la maleta y luego suelte
    m_Metadata:
      m_Items: []
  - m_Id: 980641584967680
    m_Localized: "Ponga el cursor sobre el objeto o pulse sobre \xE9l para ver su
      nombre"
    m_Metadata:
      m_Items: []
  - m_Id: 981056879783936
    m_Localized: "No todos los cajones tendr\xE1n algo dentro. Ahora, vuelva a la
      habitaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 981263440867328
    m_Localized: "Pulse aqu\xED para revisar los objetos que necesita en caso de
      que haya olvidado"
    m_Metadata:
      m_Items: []
  - m_Id: 1007719978037248
    m_Localized: Pulse en la maleta para ver lo que ha metido
    m_Metadata:
      m_Items: []
  - m_Id: 1008035591024640
    m_Localized: Pulse el icono de abajo para cerrar la maleta
    m_Metadata:
      m_Items: []
  - m_Id: 1008127668580352
    m_Localized: Puede ver el contenido de los cajones pulsando sobre ellos
    m_Metadata:
      m_Items: []
  - m_Id: 1008270274916352
    m_Localized: Puede arrastrar el objeto fuera de la maleta para sacarlo
    m_Metadata:
      m_Items: []
  - m_Id: 1009206221271040
    m_Localized: "Revise su equipaje y pulse el icono del avi\xF3n para marcharse
      de viaje"
    m_Metadata:
      m_Items: []
  - m_Id: 1010056146644992
    m_Localized: "El n\xFAmero indica la cantidad de veces que se puede revisar la
      lista. Una vez llegue a 0, no podr\xE1 volver a revisarla"
    m_Metadata:
      m_Items: []
  - m_Id: 1010146311598080
    m_Localized: Vuelva a meter la camiseta amarilla en la maleta
    m_Metadata:
      m_Items: []
  - m_Id: 1010287504453632
    m_Localized: "Puede pulsar el icono de la derecha para ir al ba\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 1010463212236800
    m_Localized: "Vuelva a pulsar el icono para volver a la habitaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 1390149144584192
    m_Localized: Ajustes
    m_Metadata:
      m_Items: []
  - m_Id: 1730597096693760
    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 1738889273450496
    m_Localized: "G\xE9nero"
    m_Metadata:
      m_Items: []
  - m_Id: 195977739431440384
    m_Localized: Pulse sobre la camiseta amarilla y mantenga pulsado
    m_Metadata:
      m_Items: []
  - m_Id: 2088170123599872
    m_Localized: "Inicie sesi\xF3n en la p\xE1gina que se le muestra..."
    m_Metadata:
      m_Items: []
  - m_Id: 31801445282156544
    m_Localized: "Director: \n\nBALTASAR FERN\xC1NDEZ MANJ\xD3N\n\n\nAsesoras t\xE9cnicas:\n\nMARIA
      DEL CARMEN D\xCDAZ MARDOMINGO\nSARA GARC\xCDA HERRANZ\n\n\nJefe de desarrollo:\n\nDAVID
      P\xC9REZ COGOLLUDO\n\n\nDesarrolladores:\n\nDAVID P\xC9REZ COGOLLUDO\nMIGUEL
      JIM\xC9NEZ RODR\xCDGUEZ\nMANUEL HIDALGO LORENTE\nNANXI QIN \nJIANUO WEN HU\nMATT
      CASTELLANOS SILVA\n\n\nGrafistas:\n\nPALOMA ASENSIO SOLANA\nROSA M PEROMINGO
      GUZM\xC1N\nANA VALLECILLOS RUIZ\nNANXI QIN\n\n\nM\xFAsica:\n\nNANXI QIN"
    m_Metadata:
      m_Items: []
  - m_Id: 196735225763590144
    m_Localized: (Pulse para continuar)
    m_Metadata:
      m_Items: []
