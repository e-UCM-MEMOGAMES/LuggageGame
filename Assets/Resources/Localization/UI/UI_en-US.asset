  m_TableData:
  - m_Id: 1189262585856
    m_Localized: Are you sure you want to exit?
    m_Metadata:
      m_Items: []
  - m_Id: 1286796931072
    m_Localized: 'Congratulations!

      You got selected for a free trip'
    m_Metadata:
      m_Items: []
  - m_Id: 1414970667008
    m_Localized: You'll have to go make your luggage now!
    m_Metadata:
      m_Items: []
  - m_Id: 4737568272384
    m_Localized: Tap on the button down below to start!
    m_Metadata:
      m_Items: []
